# Configuración de Entorno - GASTITO Frontend

# Capa de Datos:
# - Dejar vacío o poner "mock" para usar los datos simulados en memoria / localStorage.
# - Para conectar a la API real de .NET 8, ingresar la URL base del backend, por ejemplo:
# VITE_API_BASE_URL=http://localhost:5000/api/v1
# VITE_API_BASE_URL=http://localhost:5163/api/v1

VITE_API_BASE_URL=mock
VITE_USE_MOCKS=true
